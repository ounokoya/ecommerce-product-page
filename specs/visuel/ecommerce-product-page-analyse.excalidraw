nNonce": 1995610363, "verticalAlign": "top"}, {"id": "ep-2a-tab", "type": "rectangle", "x": 11700, "y": 7528, "width": 2420, "height": 560, "angle": 0, "backgroundColor": "#f8f9fa", "boundElements": null, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "bpW", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 0, "roundness": {"type": 3}, "seed": 1416275588, "strokeColor": "#ced4da", "strokeStyle": "solid", "strokeWidth": 1, "updated": 1793832175609, "version": 1, "versionNonce": 625312}, {"id": "ep-2a-tab-t", "type": "text", "x": 11724, "y": 7548, "width": 374, "height": 27.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 22, "frameId": null, "groupIds": [], "index": "bpX", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Inventaire (19 groupes d'éléments)", "roughness": 1, "roundness": null, "seed": 1993813653, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "Inventaire (19 groupes d'éléments)", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 1394842851, "verticalAlign": "top"}, {"id": "ep-2a-tab-b", "type": "text", "x": 11724, "y": 7592, "width": 2372, "height": 440, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 3, "fontSize": 16, "frameId": null, "groupIds": [], "index": "bpY", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "  #   Élément                     HTML                        Survol                              Focus clavier          Actif / autre\n  1   Liens du menu (×5)          a href=#                    texte foncé + barre Orange 4 px      contour 2 px            —\n  2   Bouton menu mobile          button aria-expanded        icône Very dark blue                 contour                 ouvre le panneau\n  3   Fermer le menu              button                      icône Very dark blue (≈)             contour                 Échap aussi\n  4   Liens du menu mobile (×5)   a href=#                    texte Orange (proposition)           contour                 —\n  5   Bouton panier               button aria-expanded        icône Very dark blue                 contour                 ouvre / ferme la carte\n  6   Avatar                      a href=# « Your profile »   anneau Orange 2 px                   contour                 —\n  7   Grande photo (≥ 1024)       button                      curseur main, voile léger (prop.)    contour                 ouvre la visionneuse\n  8   Miniatures (×4)             button aria-pressed         voile blanc 50 %                     contour                 actif : bordure Orange + voile 75 %\n  9   Flèches carrousel (×2)      button aria-label           chevron Orange                       contour                 —\n  10  Quantité −  /  +            button aria-label           icône Orange plus claire             contour                 − sans effet à 0\n  11  Valeur de la quantité       output (annoncée)           —                                    —                       —\n  12  Add to cart                 button                      Orange plus clair                    contour                 sans effet à 0\n  13  Supprimer l'article         button aria-label           icône plus foncée (≈)                contour                 vide le panier\n  14  Checkout                    button                      Orange plus clair                    contour                 ferme le panier (Q6)\n  15  Visionneuse : fermer        button                      icône Orange                         contour                 Échap aussi\n  16  Visionneuse : flèches       button                      chevron Orange                       contour                 ← → au clavier\n  17  Visionneuse : miniatures    button aria-pressed         voile blanc                          contour                 actif : bordure Orange\n  18  Fond de la visionneuse/menu  —                           —                                    —                       clic = fermer\n  19  Liens du pied de page (×2)  a                           soulignement retiré (leçon R2)       contour                 —\n\nContour de focus partout : 2 px, décalé de 2 px, Orange ou Very dark blue selon le fond (focus jamais signalé par la couleur seule).", "roughness": 1, "roundness": null, "seed": 1078260297, "strokeColor": "#343a40", "strokeStyle": "solid", "strokeWidth": 2, "text": "  #   Élément                     HTML                        Survol                              Focus clavier          Actif / autre\n  1   Liens du menu (×5)          a href=#                    texte foncé + barre Orange 4 px      contour 2 px            —\n  2   Bouton menu mobile          button aria-expanded        icône Very dark blue                 contour                 ouvre le panneau\n  3   Fermer le menu              button                      icône Very dark blue (≈)             contour                 Échap aussi\n  4   Liens du menu mobile (×5)   a href=#                    texte Orange (proposition)           contour                 —\n  5   Bouton panier               button aria-expanded        icône Very dark blue                 contour                 ouvre / ferme la carte\n  6   Avatar                      a href=# « Your profile »   anneau Orange 2 px                   contour                 —\n  7   Grande photo (≥ 1024)       button                      curseur main, voile léger (prop.)    contour                 ouvre la visionneuse\n  8   Miniatures (×4)             button aria-pressed         voile blanc 50 %                     contour                 actif : bordure Orange + voile 75 %\n  9   Flèches carrousel (×2)      button aria-label           chevron Orange                       contour                 —\n  10  Quantité −  /  +            button aria-label           icône Orange plus claire             contour                 − sans effet à 0\n  11  Valeur de la quantité       output (annoncée)           —                                    —                       —\n  12  Add to cart                 button                      Orange plus clair                    contour                 sans effet à 0\n  13  Supprimer l'article         button aria-label           icône plus foncée (≈)                contour                 vide le panier\n  14  Checkout                    button                      Orange plus clair                    contour                 ferme le panier (Q6)\n  15  Visionneuse : fermer        button                      icône Orange                         contour                 Échap aussi\n  16  Visionneuse : flèches       button                      chevron Orange                       contour                 ← → au clavier\n  17  Visionneuse : miniatures    button aria-pressed         voile blanc                          contour                 actif : bordure Orange\n  18  Fond de la visionneuse/menu  —                           —                                    —                       clic = fermer\n  19  Liens du pied de page (×2)  a                           soulignement retiré (leçon R2)       contour                 —\n\nContour de focus partout : 2 px, décalé de 2 px, Orange ou Very dark blue selon le fond (focus jamais signalé par la couleur seule).", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 2116686763, "verticalAlign": "top"}, {"id": "ep-2b-t", "type": "text", "x": 11700, "y": 8148, "width": 231, "height": 27.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 22, "frameId": null, "groupIds": [], "index": "bpZ", "isDeleted"