: 1, "versionNonce": 1838783344, "verticalAlign": "top"}, {"id": "ep-1e-b2", "type": "rectangle", "x": 11700, "y": 6600, "width": 440, "height": 140, "angle": 0, "backgroundColor": "#f3f0ff", "boundElements": null, "fillStyle": "solid", "frameId": null, "groupIds": ["ep-1e-b2-g"], "index": "bpL", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 0, "roundness": {"type": 3}, "seed": 1526696238, "strokeColor": "#6741d9", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1793832175608, "version": 1, "versionNonce": 1221971238}, {"id": "ep-1e-b2-t", "type": "text", "x": 11768.19, "y": 6627.5, "width": 303.62, "height": 85, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 17, "frameId": null, "groupIds": ["ep-1e-b2-g"], "index": "bpM", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Desktop — 1024 px et plus\n\nen-tête complet, galerie + miniatures,\n2 colonnes, visionneuse", "roughness": 1, "roundness": null, "seed": 865516941, "strokeColor": "#6741d9", "strokeStyle": "solid", "strokeWidth": 2, "text": "Desktop — 1024 px et plus\n\nen-tête complet, galerie + miniatures,\n2 colonnes, visionneuse", "textAlign": "center", "updated": 1793832175608, "version": 1, "versionNonce": 499929177, "verticalAlign": "top"}, {"id": "ep-1f-t", "type": "text", "x": 12220, "y": 6210, "width": 462, "height": 27.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 22, "frameId": null, "groupIds": [], "index": "bpN", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "1F · Arbre de composants → HTML sémantique", "roughness": 1, "roundness": null, "seed": 1365749399, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "1F · Arbre de composants → HTML sémantique", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 1688018145, "verticalAlign": "top"}, {"id": "ep-1f-box", "type": "rectangle", "x": 12220, "y": 6260, "width": 1000, "height": 560, "angle": 0, "backgroundColor": "#ffffff", "boundElements": null, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "bpO", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 0, "roundness": {"type": 3}, "seed": 2066757390, "strokeColor": "#ced4da", "strokeStyle": "solid", "strokeWidth": 1, "updated": 1793832175609, "version": 1, "versionNonce": 360076934}, {"id": "ep-1f-b", "type": "text", "x": 12244, "y": 6280, "width": 960, "height": 400, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 3, "fontSize": 16, "frameId": null, "groupIds": [], "index": "bpP", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "header\n├─ button      menu mobile (aria-expanded, aria-controls)        < 1024 px\n├─ a > img     logo « sneakers »\n├─ nav         5 liens (#) ; panneau + fond en mobile\n├─ button      panier (aria-expanded) + pastille (dans le nom accessible)\n├─ div         carte du panier (région, Échap / clic dehors pour fermer)\n└─ a > img     avatar (« Your profile »)\nmain\n├─ section     galerie\n│  ├─ button > img   grande photo → ouvre la visionneuse         ≥ 1024 px\n│  ├─ button × 2     flèches du carrousel                         < 1024 px\n│  └─ ul > li > button > img   4 miniatures (aria-pressed)       ≥ 1024 px\n└─ section     produit\n   ├─ p        SNEAKER COMPANY\n   ├─ h1       Fall Limited Edition Sneakers\n   ├─ p        description\n   ├─ prix     $125.00 · 50% · <s>$250.00</s>\n   └─ form ou div   quantité (− output +) + button Add to cart\ndialog         visionneuse (aria-modal) : fermer, photo, flèches, miniatures\nfooter         attribution (liens avec survol, leçon R2)", "roughness": 1, "roundness": null, "seed": 450196039, "strokeColor": "#343a40", "strokeStyle": "solid", "strokeWidth": 2, "text": "header\n├─ button      menu mobile (aria-expanded, aria-controls)        < 1024 px\n├─ a > img     logo « sneakers »\n├─ nav         5 liens (#) ; panneau + fond en mobile\n├─ button      panier (aria-expanded) + pastille (dans le nom accessible)\n├─ div         carte du panier (région, Échap / clic dehors pour fermer)\n└─ a > img     avatar (« Your profile »)\nmain\n├─ section     galerie\n│  ├─ button > img   grande photo → ouvre la visionneuse         ≥ 1024 px\n│  ├─ button × 2     flèches du carrousel                         < 1024 px\n│  └─ ul > li > button > img   4 miniatures (aria-pressed)       ≥ 1024 px\n└─ section     produit\n   ├─ p        SNEAKER COMPANY\n   ├─ h1       Fall Limited Edition Sneakers\n   ├─ p        description\n   ├─ prix     $125.00 · 50% · <s>$250.00</s>\n   └─ form ou div   quantité (− output +) + button Add to cart\ndialog         visionneuse (aria-modal) : fermer, photo, flèches, miniatures\nfooter         attribution (liens avec survol, leçon R2)", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 262378411, "verticalAlign": "top"}, {"id": "ep-g2", "type": "text", "x": 11700, "y": 6890, "width": 854, "height": 35, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 28, "frameId": null, "groupIds": [], "index": "bpQ", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "2 · COMPORTEMENT — éléments interactifs, états, accessibilité", "roughness": 1, "roundness": null, "seed": 1871497394, "strokeColor": "#6741d9", "strokeStyle": "solid", "strokeWidth": 2, "text": "2 · COMPORTEMENT — éléments interactifs, états, accessibilité", "textAlign": "left", "updat