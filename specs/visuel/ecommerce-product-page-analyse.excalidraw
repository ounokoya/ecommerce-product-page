ype": "text", "x": 12778.09, "y": 8226.75, "width": 143.82, "height": 42.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 17, "frameId": null, "groupIds": ["ep-st-lc-g"], "index": "bmp", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "VISIONNEUSE FERMÉE\n(≥ 1024 px)", "roughness": 1, "roundness": null, "seed": 732554381, "strokeColor": "#495057", "strokeStyle": "solid", "strokeWidth": 2, "text": "VISIONNEUSE FERMÉE\n(≥ 1024 px)", "textAlign": "center", "updated": 1793832175609, "version": 1, "versionNonce": 806445535, "verticalAlign": "top"}, {"id": "ep-st-lo", "type": "rectangle", "x": 13220, "y": 8208, "width": 300, "height": 80, "angle": 0, "backgroundColor": "#fff4e6", "boundElements": [{"id": "ep-st-lc--ep-st-lo", "type": "arrow"}], "fillStyle": "solid", "frameId": null, "groupIds": ["ep-st-lo-g"], "index": "bmq", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 0, "roundness": {"type": 3}, "seed": 1625037246, "strokeColor": "#e8590c", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1793832175609, "version": 1, "versionNonce": 1069639592}, {"id": "ep-st-lo-t", "type": "text", "x": 13294.095, "y": 8226.75, "width": 151.81, "height": 42.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 17, "frameId": null, "groupIds": ["ep-st-lo-g"], "index": "bmr", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "VISIONNEUSE OUVERTE\nimage n (1 à 4)", "roughness": 1, "roundness": null, "seed": 1158952719, "strokeColor": "#e8590c", "strokeStyle": "solid", "strokeWidth": 2, "text": "VISIONNEUSE OUVERTE\nimage n (1 à 4)", "textAlign": "center", "updated": 1793832175609, "version": 1, "versionNonce": 1921702581, "verticalAlign": "top"}, {"id": "ep-st-lc--ep-st-lo", "type": "arrow", "x": 13008, "y": 8248, "angle": 0, "backgroundColor": "transparent", "boundElements": null, "elbowed": false, "endArrowhead": "arrow", "endBinding": {"elementId": "ep-st-lo", "fixedPoint": null, "focus": 0, "gap": 4}, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "bms", "isDeleted": false, "lastCommittedPoint": null, "link": null, "locked": false, "opacity": 100, "points": [[0, 0], [204, 0]], "roughness": 0, "roundness": null, "seed": 657993051, "startArrowhead": null, "startBinding": {"elementId": "ep-st-lc", "fixedPoint": null, "focus": 0, "gap": 4}, "strokeColor": "#e8590c", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1793832175609, "version": 1, "versionNonce": 17233969}, {"id": "ep-st-lolc", "type": "arrow", "x": 13370, "y": 8288, "angle": 0, "backgroundColor": "transparent", "boundElements": null, "elbowed": false, "endArrowhead": "arrow", "endBinding": null, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "bmt", "isDeleted": false, "lastCommittedPoint": null, "link": null, "locked": false, "opacity": 100, "points": [[0, 0], [0, 60], [-520, 60], [-520, 0]], "roughness": 0, "roundness": null, "seed": 1501417937, "startArrowhead": null, "startBinding": null, "strokeColor": "#495057", "strokeStyle": "dashed", "strokeWidth": 2, "updated": 1793832175609, "version": 1, "versionNonce": 58861427}, {"id": "ep-st-lolc-t", "type": "text", "x": 12910, "y": 8356, "width": 441, "height": 17.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 14, "frameId": null, "groupIds": [], "index": "bmu", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "fermer, Échap ou clic sur le fond → focus rendu à la photo (Q7)", "roughness": 1, "roundness": null, "seed": 714631504, "strokeColor": "#495057", "strokeStyle": "solid", "strokeWidth": 2, "text": "fermer, Échap ou clic sur le fond → focus rendu à la photo (Q7)", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 1834551610, "verticalAlign": "top"}, {"id": "ep-st-misc", "type": "text", "x": 11700, "y": 8408, "width": 2000, "height": 85, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 17, "frameId": null, "groupIds": [], "index": "bmv", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Menu mobile : fermé ou ouvert (bouton menu / fermer / Échap / clic sur le fond) ; focus gardé dans le panneau.\nCarte du panier : fermée ou ouverte (bouton panier / Échap / clic dehors) ; s'affiche par-dessus la page.\nImage affichée : n de 1 à 4 ; miniatures et flèches la changent ; les flèches bouclent (4 → 1, 1 → 4).\nQuantité : entier ≥ 0 ; − sans effet à 0 ; + sans limite haute (proposition).", "roughness": 1, "roundness": null, "seed": 396964145, "strokeColor": "#343a40", "strokeStyle": "solid", "strokeWidth": 2, "text": "Menu mobile : fermé ou ouvert (bouton menu / fermer / Échap / clic sur le fond) ; focus gardé dans le panneau.\nCarte du panier : fermée ou ouverte (bouton panier / Échap / clic dehors) ; s'affiche par-dessus la page.\nImage affichée : n de 1 à 4 ; miniatures et flèches la changent ; les flèches bouclent (4 → 1, 1 → 4).\nQuantité : entier ≥ 0 ; − sans effet à 0 ; + sans limite haute (proposition).", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 2135902037, "verticalAlign": "top"}, {"id": "ep-2c-t", "type": "text", "x": 11700, "y": 8538, "width": 198, "height": 27.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 22, "frameId": null, "groupIds": [], "index": "bmw", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "2C · Accessibilité", "roughness": 1, "roundness": null, "seed": 382690943, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "2C · Accessibilité", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 180046091, "verticalAlign": "top"}, {"id": "ep-2c-b", "type": "text", "x": 11700, "y": 8578, "width": 2300, "height": 170, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 17, "frameId": null, "groupIds": [], "index": "bmx", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "•  Visionneuse et menu mobile : fenêtres modales (dialog), focus gardé dedans, Échap pour fermer, focus rendu au déclencheur.\n•  Carrousel et miniatures : boutons nommés (« Previous image », « Show image 2 ») ; l'image affichée est annoncée.\n•  Panier : nom du bouton « Cart, 3 items » ; ajout et suppression annoncés (aria-live) ; quantité annoncée.\n•  Photos produit : texte alternatif court ; miniatures dans des boutons nommés ; icônes décoratives (alt=\"\").\n•  Contrastes mesurés (AA : 4,5:1 texte, 3:1 icônes et composants) :\n     OK : menu et description 5,0:1 · titre et prix 16,3:1 · « 50% » 16,3:1 · « Add to cart » 6,4:1 · flèches 16,3:1\n     Insuffisant : ancien prix (Grayish blue) 1,9:1 (Q1) · chiffre de la pastille blanc sur Orange 2,6:1 (Q2)\n     · icônes − + Orange sur Light grayish blue 2,4:1 (Q3)", "roughness": 1, "roundness": null, "seed": 1714682769, "strokeColor": "#343a40", "strokeStyle": "solid", "strokeWidth": 2, "text": "•  Visionneuse et menu mobile : fenêtres modales (dialog), focus gardé dedans, Échap pour fermer, focus rendu au déclencheur.\n•  Carrousel et miniatures : boutons nommés (« Previous image », « Show image 2 ») ; l'image affichée est annoncée.\n•  Panier : nom du bouton « Cart, 3 items » ; ajout et suppression annoncés (aria-live) ; quantité annoncée.\n•  Photos produit : texte alternatif court ; miniatures dans des boutons nommés ; icônes décoratives (alt=\"\").\n•  Contrastes mesurés (AA : 4,5:1 texte, 3:1 icônes et composants) :\n     OK : menu et description 5,0:1 · titre et prix 16,3:1 · « 50% » 16,3:1 · « Add to cart » 6,4:1 · flèches 16,3:1\n     Insuffisant : ancien prix (Grayish blue) 1,9:1 (Q1) · chiffre de la pastille blanc sur Orange 2,6:1 (Q2)\n     · icônes − + Orange sur Light grayish blue 2,4:1 (Q3)", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 395128883, "verticalAlign": "top"}, {"id": "ep-2d-box", "type": "rectangle", "x": 11680, "y": 8808, "width": 2460, "height": 330, "angle": 0, "backgroundColor": "#fff5f5", "boundElements": null, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "bmy", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 0, "roundness": {"type": 3}, "seed": 1255173743, "strokeColor": "#e03131", "strokeStyle": "solid", "strokeWidth": 3, "updated": 1793832175609, "version": 1, "versionNonce": 135421881}, {"id": "ep-2d-t", "type": "text", "x": 11700, "y": 8828, "width": 748, "height": 27.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 22, "frameId": null, "groupIds": [], "index": "bmz", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "2D · Questions pour ta validation — ma proposition entre parenthèses", "roughness": 1, "roundness": null, "seed": 40998826, "strokeColor": "#e03131", "strokeStyle": "solid", "strokeWidth": 2, "text": "2D · Questions pour ta validation — ma proposition entre parenthèses", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 1286831684, "verticalAlign": "top"}, {"id": "ep-2d-b", "type": "text", "x": 11700, "y": 8872, "width": 2400, "height": 191.25, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 2, "fontSize": 17, "frameId": null, "groupIds": [], "index": "bn0", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Q1  Ancien prix à 1,9:1. (Dark grayish blue, 5,0:1, toujours barré.)\nQ2  Chiffre de la pastille à 2,6:1. (Chiffre en Very dark blue sur l'Orange : 6,4:1 ; la pastille garde sa couleur.)\nQ3  Icônes − + à 2,4:1. (Orange plus foncé pour ces icônes : hsl(26, 100%, 46%), 3,1:1.)\nQ4  Tablette, pas de maquette. (Structure mobile, photo et contenu centrés sur ≈ 550 px, photo arrondie, de 640 à 1023 px.)\nQ5  L'image des états montre le sélecteur à 3 après l'ajout. (On garde la décision du plan : retour à 0, quantités additionnées.)\nQ6  Panier : ouverture au clic, pas au survol. (Clic sur l'icône ; fermeture par un 2e clic, Échap, clic dehors ou « Checkout ».)\nQ7  Visionneuse et page. (Elle s'ouvre sur l'image affichée ; à la fermeture, la page montre la dernière image vue.)\nQ8  États non dessinés : liens du menu mobile, supprimer, grande photo. (Orange, plus foncé, voile léger — voir l'inventaire.)\nQ9  Police Kumbh Sans non fournie par FM. (Décision en Phase 5 : Google Fonts ou fichiers locaux via npm — à toi de choisir.)", "roughness": 1, "roundness": null, "seed": 849158688, "strokeColor": "#343a40", "strokeStyle": "solid", "strokeWidth": 2, "text": "Q1  Ancien prix à 1,9:1. (Dark grayish blue, 5,0:1, toujours barré.)\nQ2  Chiffre de la pastille à 2,6:1. (Chiffre en Very dark blue sur l'Orange : 6,4:1 ; la pastille garde sa couleur.)\nQ3  Icônes − + à 2,4:1. (Orange plus foncé pour ces icônes : hsl(26, 100%, 46%), 3,1:1.)\nQ4  Tablette, pas de maquette. (Structure mobile, photo et contenu centrés sur ≈ 550 px, photo arrondie, de 640 à 1023 px.)\nQ5  L'image des états montre le sélecteur à 3 après l'ajout. (On garde la décision du plan : retour à 0, quantités additionnées.)\nQ6  Panier : ouverture au clic, pas au survol. (Clic sur l'icône ; fermeture par un 2e clic, Échap, clic dehors ou « Checkout ».)\nQ7  Visionneuse et page. (Elle s'ouvre sur l'image affichée ; à la fermeture, la page montre la dernière image vue.)\nQ8  États non dessinés : liens du menu mobile, supprimer, grande photo. (Orange, plus foncé, voile léger — voir l'inventaire.)\nQ9  Police Kumbh Sans non fournie par FM. (Décision en Phase 5 : Google Fonts ou fichiers locaux via npm — à toi de choisir.)", "textAlign": "left", "updated": 1793832175609, "version": 1, "versionNonce": 778639754, "verticalAlign": "top"}, {"id": "ep-img-desktop", "type": "image", "x": 11700, "y": 2210, "width": 1440, "height": 900, "angle": 0, "backgroundColor": "transparent", "boundElements": null, "crop": null, "fileId": "ep-img-desktop-file", "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "bn1", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 0, "roundness": null, "scale": [1, 1], "seed": 1, "status": "saved", "strokeColor": "transparent", "strokeStyle": "solid", "strokeWidth": 1, "updated": 1793832172656, "version": 1, "versionNonce": 1}, {"id": "ep-img-cart", "type": "image", "x": 11700, "y": 3220, "width": 1440, "height": 900, "angle": 0, "backgroundColor": "transparent", "boundElements": null, "crop": null, "fileId": "ep-img-cart-file", "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "bn2", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 0, "roundness": null, "scale": [1, 1], "seed": 2, "status": "saved", "strokeColor": "transparent", "strokeStyle": "solid", "strokeWidth": 1, "updated": 1793832172656, "version": 1, "versionNonce": 2}, {"id": "ep-img-lb", "type": "image", "x": 11700, "y": 4230, "width": 1440, "height": 900, "angle": 0, "backgroundColor": "transparent", "boundElements": null, "crop": null, "fileId": "ep-img-l